{
  "expo": {
    "name": "cameratest",
    "slug": "cameratest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cameratest",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Приложению нужен доступ к камере, чтобы делать фото",
        "NSPhotoLibraryUsageDescription": "Приложению нужен доступ к галерее, чтобы выбирать фото"
      }
    },
    "android": {
      "permissions": ["CAMERA", "READ_CONTACTS", "READ_MEDIA_IMAGES", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "Приложению нужен доступ к контактам, чтобы выбирать контакт"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Приложению нужна геолокация, чтобы показать ваши координаты"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ]
  }
}
